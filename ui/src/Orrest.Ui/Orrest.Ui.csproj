<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- [LibraryImport] 源生成的封送代码使用 unsafe 指针 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 独立发布：dotnet pack 即可产出 NuGet 包（包 ID 默认取程序集名 Orrest.Ui） -->
    <Version>0.1.0</Version>
    <Authors>OR</Authors>
    <Description>Orrest 自定义 WPF 组件与样式库。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- TrayIconBehavior 依赖 Behavior<T>；版本由 Directory.Packages.props 集中管理 -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Skottie" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

</Project>

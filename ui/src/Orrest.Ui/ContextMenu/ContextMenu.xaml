<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--
        ContextMenu 样式：简洁 / 圆角 / 1px 边框线（无阴影）。
        度量常量来自 ContextMenuTheme（x:Static）；颜色经 ContextMenu.* 画刷键引用，
        主题由 ThemeManager 切换聚合字典 Theme.Light|Dark.xaml 决定，本字典与之一同合并到应用资源。

        背景透明度：所有背景面均为独立"背景层"（底）+ 内容层（上）的分层结构，
        背景层的 Opacity 绑定 Theme.BackgroundOpacity 资源（默认值定义在总主题字典，
        可经 ThemeManager.SetBackgroundOpacity 运行时调整），不影响内容清晰度。
        未合并总主题字典时绑定落空，背景层保持默认 Opacity=1，样式不失效。

        注意：三个样式均为隐式样式，合并后作用于应用内所有右键菜单。
    -->

    <!--  菜单容器：边框线外框 + 可调透明度背景层 + 滚动内容层  -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource ContextMenu.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenu.Border}" />
        <Setter Property="BorderThickness" Value="{x:Static themes:ContextMenuTheme.MenuBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{x:Static themes:ContextMenuTheme.MenuCornerRadius}">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="{x:Static themes:ContextMenuTheme.MenuCornerRadius}"
                                Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Hidden"
                                Padding="{x:Static themes:ContextMenuTheme.MenuPadding}"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  菜单项：可调透明度的圆角悬停高亮层 + 勾选列 + 文本 + 快捷键/子菜单箭头  -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ContextMenu.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border
                            Margin="{x:Static themes:ContextMenuTheme.ItemMargin}"
                            CornerRadius="{x:Static themes:ContextMenuTheme.ItemCornerRadius}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <!--  高亮背景层：触发器改变菜单项 Background，透明度随全局资源  -->
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{x:Static themes:ContextMenuTheme.ItemCornerRadius}"
                                    Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                                <Border Padding="{x:Static themes:ContextMenuTheme.ItemPadding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Static themes:ContextMenuTheme.GlyphColumnWidth}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  勾选标记（仅 IsCheckable 项勾选后显示）  -->
                                        <Path
                                            x:Name="CheckGlyph"
                                            Grid.Column="0"
                                            Width="11"
                                            Height="9"
                                            VerticalAlignment="Center"
                                            Data="M 1 4.5 L 4 7.5 L 10 1"
                                            Stretch="None"
                                            Stroke="{DynamicResource ContextMenu.Glyph}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.8"
                                            Visibility="Collapsed" />
                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True" />
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="GestureText"
                                                Margin="18,0,0,0"
                                                Opacity="0.6"
                                                Text="{TemplateBinding InputGestureText}" />
                                            <Path
                                                x:Name="SubmenuArrow"
                                                Width="5"
                                                Height="9"
                                                Margin="10,0,2,0"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 L 5 4.5 L 0 9"
                                                Fill="{DynamicResource ContextMenu.Foreground}"
                                                Opacity="0.7"
                                                Stretch="None"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <!--  子菜单弹出层（无子菜单时不弹出）：与菜单容器同风格  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsSubmenuOpen}"
                            Placement="Right"
                            PopupAnimation="None">
                            <Border
                                Margin="4"
                                BorderBrush="{DynamicResource ContextMenu.Border}"
                                BorderThickness="{x:Static themes:ContextMenuTheme.MenuBorderThickness}"
                                CornerRadius="{x:Static themes:ContextMenuTheme.MenuCornerRadius}">
                                <Grid>
                                    <Border
                                        Background="{DynamicResource ContextMenu.Background}"
                                        CornerRadius="{x:Static themes:ContextMenuTheme.MenuCornerRadius}"
                                        Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                                    <Border Padding="{x:Static themes:ContextMenuTheme.MenuPadding}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ContextMenu.Highlight}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ContextMenu.Highlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ContextMenu.DisabledForeground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  分隔线：1px 细线  -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource ContextMenu.Separator}" />
        <Setter Property="Margin" Value="{x:Static themes:ContextMenuTheme.SeparatorMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle
                        Height="1"
                        Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

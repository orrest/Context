<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--  暗色主题：画刷键映射自 CommonThemeDark / TextBoxThemeDark 颜色常量，
          与 TextBox/TextBox.xaml 搭配使用（ThemeManager 合并本字典即选用暗色主题）  -->
    <SolidColorBrush x:Key="TextBox.Background"
                     Color="{x:Static themes:CommonThemeDark.Background}" />
    <SolidColorBrush x:Key="TextBox.Border"
                     Color="{x:Static themes:CommonThemeDark.Border}" />
    <SolidColorBrush x:Key="TextBox.Foreground"
                     Color="{x:Static themes:CommonThemeDark.Foreground}" />
    <SolidColorBrush x:Key="TextBox.Hover"
                     Color="{x:Static themes:CommonThemeDark.Hover}" />
    <SolidColorBrush x:Key="TextBox.FocusedBorder"
                     Color="{x:Static themes:TextBoxThemeDark.FocusedBorder}" />
    <SolidColorBrush x:Key="TextBox.DisabledForeground"
                     Color="{x:Static themes:TextBoxThemeDark.DisabledForeground}" />

</ResourceDictionary>

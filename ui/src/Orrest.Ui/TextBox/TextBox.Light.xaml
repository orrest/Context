<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--  浅色主题：画刷键映射自 CommonThemeLight / TextBoxThemeLight 颜色常量，
          与 TextBox/TextBox.xaml 搭配使用（ThemeManager 合并本字典即选用浅色主题）  -->
    <SolidColorBrush x:Key="TextBox.Background"
                     Color="{x:Static themes:CommonThemeLight.Background}" />
    <SolidColorBrush x:Key="TextBox.Border"
                     Color="{x:Static themes:CommonThemeLight.Border}" />
    <SolidColorBrush x:Key="TextBox.Foreground"
                     Color="{x:Static themes:CommonThemeLight.Foreground}" />
    <SolidColorBrush x:Key="TextBox.Hover"
                     Color="{x:Static themes:CommonThemeLight.Hover}" />
    <SolidColorBrush x:Key="TextBox.FocusedBorder"
                     Color="{x:Static themes:TextBoxThemeLight.FocusedBorder}" />
    <SolidColorBrush x:Key="TextBox.DisabledForeground"
                     Color="{x:Static themes:TextBoxThemeLight.DisabledForeground}" />

</ResourceDictionary>

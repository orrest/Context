<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--
        TabControl / TabItem 样式：极简下划线式标签页——选中标签仅以强调色指示条标示，
        前景（含页头与页内文字）始终为常规前景色；未选中标签悬停时以 Hover 底提示。
        度量常量来自 TabControlTheme（x:Static）；
        颜色经 TabItem.* 画刷键引用，主题由 ThemeManager 切换聚合字典 Theme.Light|Dark.xaml 决定。
        注意：隐式样式，合并后作用于应用内所有 TabControl / TabItem。
    -->

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource TabItem.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  标签页头：TabPanel + 底部分隔线  -->
                        <Border
                            BorderBrush="{DynamicResource TabItem.PanelBorder}"
                            BorderThickness="0,0,0,1">
                            <TabPanel
                                Background="Transparent"
                                IsItemsHost="True" />
                        </Border>
                        <!--  当前页内容  -->
                        <ContentPresenter
                            Grid.Row="1"
                            ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TabItem.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!--  根节点透明底保证整块可点击；指示条贴在标签页分隔线上  -->
                    <Grid
                        x:Name="Root"
                        Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  Hover highlight layer: rounded-corner rectangle painted under content.
                              悬停高亮层：圆角矩形底，位于内容与指示条之下，触发器仅改其背景。  -->
                        <Border
                            x:Name="HoverBackground"
                            Grid.RowSpan="2"
                            Background="Transparent"
                            CornerRadius="4" />
                        <ContentPresenter
                            Margin="{x:Static themes:TabControlTheme.TabPadding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True" />
                        <Rectangle
                            x:Name="Underline"
                            Grid.Row="1"
                            Height="{x:Static themes:TabControlTheme.UnderlineHeight}"
                            Margin="{x:Static themes:TabControlTheme.UnderlineMargin}"
                            Fill="{DynamicResource TabItem.SelectedUnderline}"
                            RadiusX="1"
                            RadiusY="1"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停（未选中）：Hover 底；选中标签不再叠加悬停底  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverBackground" Property="Background" Value="{DynamicResource TabItem.Hover}" />
                        </MultiTrigger>
                        <!--  选中：指示条标示；前景保持常规色，避免紫色强调经逻辑树
                              （页内容是 TabItem 的逻辑子级）继承到页内全部文字  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--  禁用：整体半透明（覆盖选中/未选中全部状态）  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{x:Static themes:TabControlTheme.DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

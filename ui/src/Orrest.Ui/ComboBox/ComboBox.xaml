<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--
        ComboBox 样式：简洁 / 圆角 / 1px 边框线（无阴影）。
        度量常量来自 ComboBoxTheme（x:Static）；颜色经 ComboBox.* 画刷键引用，
        主题由 ThemeManager 切换聚合字典 Theme.Light|Dark.xaml 决定，本字典与之一同合并到应用资源。

        背景透明度：同 ContextMenu —— 框体与下拉弹出层均为独立"背景层"（底）+ 内容层（上）的分层结构，
        背景层的 Opacity 绑定 Theme.BackgroundOpacity 资源（默认值定义在总主题字典，
        可经 ThemeManager.SetBackgroundOpacity 运行时调整），不影响内容清晰度。
        未合并总主题字典时绑定落空，背景层保持默认 Opacity=1，样式不失效。

        注意：ComboBox 与 ComboBoxItem 均为隐式样式，合并后作用于应用内所有下拉框。
    -->

    <!--  收起框：边框线外框 + 可调透明度背景层 + 内容层（选中内容 / 可编辑文本 / 下拉箭头）；
          透明命中层覆盖整框承载展开/收起，编辑态下可编辑文本框浮于命中层之上正常输入  -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource ComboBox.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.Border}" />
        <Setter Property="BorderThickness" Value="{x:Static themes:ComboBoxTheme.BoxBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBox.Foreground}" />
        <Setter Property="MinHeight" Value="{x:Static themes:ComboBoxTheme.BoxMinHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static themes:ComboBoxTheme.BoxCornerRadius}">
                            <Grid>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{x:Static themes:ComboBoxTheme.BoxCornerRadius}"
                                    Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                                <Grid Margin="{x:Static themes:ComboBoxTheme.BoxPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--  非编辑态显示选中项（IsEditable 时由触发器切换为文本框）  -->
                                    <ContentPresenter
                                        x:Name="ContentSite"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        IsHitTestVisible="False" />
                                    <!--  可编辑文本框：内联显式样式优先于应用级隐式 TextBox 样式，
                                          透明无边框融入框体，模板加载即生效  -->
                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        Grid.Column="0"
                                        Visibility="Collapsed">
                                        <TextBox.Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Foreground" Value="{DynamicResource ComboBox.Foreground}" />
                                                <Setter Property="CaretBrush" Value="{DynamicResource ComboBox.Foreground}" />
                                                <Setter Property="SelectionBrush" Value="{DynamicResource ComboBox.FocusedBorder}" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ComboBox.DisabledForeground}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Path
                                        x:Name="Chevron"
                                        Grid.Column="1"
                                        Width="{x:Static themes:ComboBoxTheme.ChevronWidth}"
                                        Height="{x:Static themes:ComboBoxTheme.ChevronHeight}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 1,1.5 L 5.5,6 L 10,1.5"
                                        Opacity="0.7"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stretch="None"
                                        Stroke="{DynamicResource ComboBox.Foreground}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Grid>
                        </Border>
                        <!--  命中层：Background=Transparent 保证整框可点击（透明底仍参与命中测试）  -->
                        <ToggleButton
                            x:Name="ToggleButton"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!--  下拉弹出层：与 ContextMenu 菜单容器同风格（边框线 + 可调透明度背景层）；
                              宽度与收起框严格一致（ActualWidth 经 Binding 跟随窗口缩放实时更新）  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{DynamicResource ComboBox.Border}"
                                BorderThickness="{x:Static themes:ComboBoxTheme.DropdownBorderThickness}"
                                CornerRadius="{x:Static themes:ComboBoxTheme.DropdownCornerRadius}">
                                <Grid>
                                    <Border
                                        Background="{DynamicResource ComboBox.Background}"
                                        CornerRadius="{x:Static themes:ComboBoxTheme.DropdownCornerRadius}"
                                        Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                                    <ScrollViewer
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="{x:Static themes:ComboBoxTheme.DropdownPadding}"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.FocusedBorder}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.FocusedBorder}" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBox.DisabledForeground}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource ComboBox.DisabledForeground}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  下拉项：可调透明度的圆角悬停高亮层 + 内容（左）+ 选中标记（右）；
          分层结构同 ContextMenu 菜单项，收起框内选中值不受影响  -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource ComboBox.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        Margin="{x:Static themes:ComboBoxTheme.ItemMargin}"
                        CornerRadius="{x:Static themes:ComboBoxTheme.ItemCornerRadius}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <!--  高亮背景层：触发器改变下拉项 Background，透明度随全局资源  -->
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="{x:Static themes:ComboBoxTheme.ItemCornerRadius}"
                                Opacity="{DynamicResource Theme.BackgroundOpacity}" />
                            <Border Padding="{x:Static themes:ComboBoxTheme.ItemPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />
                                    <!--  选中标记（仅选中项显示，图形同 ContextMenu 勾选标记）  -->
                                    <Path
                                        x:Name="CheckGlyph"
                                        Grid.Column="1"
                                        Width="11"
                                        Height="9"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Data="M 1 4.5 L 4 7.5 L 10 1"
                                        Stretch="None"
                                        Stroke="{DynamicResource ComboBox.Glyph}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.8"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ComboBox.Highlight}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ComboBox.Highlight}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBox.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:Orrest.Ui.Themes">

    <!--  暗色主题：画刷键映射自 CommonThemeDark / WindowThemeDark 颜色常量，
          与 Window/Window.xaml 搭配使用（ThemeManager 合并本字典即选用暗色主题）  -->
    <SolidColorBrush x:Key="Window.Background"
                     Color="{x:Static themes:CommonThemeDark.Background}" />
    <SolidColorBrush x:Key="Window.Border"
                     Color="{x:Static themes:CommonThemeDark.Border}" />
    <SolidColorBrush x:Key="Window.Foreground"
                     Color="{x:Static themes:CommonThemeDark.Foreground}" />
    <SolidColorBrush x:Key="Window.Hover"
                     Color="{x:Static themes:CommonThemeDark.Hover}" />
    <SolidColorBrush x:Key="Window.Pressed"
                     Color="{x:Static themes:WindowThemeDark.Pressed}" />
    <SolidColorBrush x:Key="Window.CloseHover"
                     Color="{x:Static themes:WindowThemeDark.CloseHover}" />
    <SolidColorBrush x:Key="Window.ClosePressed"
                     Color="{x:Static themes:WindowThemeDark.ClosePressed}" />

</ResourceDictionary>

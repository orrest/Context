<UserControl
    x:Class="Music.Views.MusicOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Music.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MusicViewModel,
                                     IsDesignTimeCreatable=False}"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <!--
        主窗口覆盖层（播放/暂停按钮）：播放会话期间显示（暂停中也保持可见以便恢复），
        点击在播放/暂停间切换，图标随暂停状态切换；控件外留白透明，不拦截主窗口拖动。
        ViewModel 初始化由代码后置在 Loaded 触发（元素级 Loaded 触发器附加时机会错过
        首次引发，显隐状态将无从订阅）。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Button
        Width="32"
        Height="32"
        Margin="0,0,10,10"
        Padding="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Command="{Binding TogglePlayPauseCommand}"
        ToolTip="{Binding ToolTipText}"
        Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="&#xE769;" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                            <Setter Property="Text" Value="&#xE768;" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Button>
</UserControl>

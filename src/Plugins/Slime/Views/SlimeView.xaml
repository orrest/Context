<UserControl
    x:Class="Slime.Views.SlimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Orrest.Ui.Controls;assembly=Orrest.Ui">
    <!--
        纯静态桌宠视图（无 ViewModel）：透明画刷可命中测试，整个窗口范围都是悬浮区；
        操作入口在托盘菜单与应用内快捷键
    -->
    <Grid Background="Transparent">
        <!--
            史莱姆桌宠：sprite sheet 三帧动画，默认静止显示第三帧；
            控件尺寸按帧的 191:128 宽高比（sheet 573×128，横向 3 帧等宽）
        -->
        <ui:SpriteSheetView
            x:Name="Animation"
            Width="105"
            Height="70"
            VerticalAlignment="Bottom"
            FrameCount="3"
            FramesPerSecond="6"
            LoopDuration="0.9"
            RestFrame="2"
            Source="pack://application:,,,/Slime;component/Assets/the_character_animation_sheet.png" />
    </Grid>
</UserControl>

<Window x:Class="Context.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context" Height="380" Width="520">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                     Width="260" VerticalContentAlignment="Center" />
            <Button Content="添加" Command="{Binding AddCommand}" Margin="8,0,0,0" Padding="16,4" />
            <Button Content="刷新" Command="{Binding LoadCommand}" Margin="8,0,0,0" Padding="16,4" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Products}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

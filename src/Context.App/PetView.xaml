<UserControl
    x:Class="Context.App.PetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Orrest.Ui.Controls;assembly=Orrest.Ui"
    xmlns:vm="clr-namespace:Context.Presentation.ViewModels;assembly=Context.Presentation"
    d:DataContext="{d:DesignInstance Type=vm:PetViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <!--  透明画刷可命中测试：整个窗口范围都是悬浮区  -->
    <Grid
        Background="Transparent"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave">
        <!--  悬浮按钮组：鼠标进入后浮出  -->
        <StackPanel
            x:Name="ActionButtonPanel"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Panel.ZIndex="99"
            Visibility="Collapsed">
            <Button
                Command="{Binding NextWallpaperCommand}"
                Content="壁纸" />
            <Button
                Command="{Binding OpenDictionaryCommand}"
                Content="词典" />
            <Button
                Click="OnExitClick"
                Content="退出" />
        </StackPanel>
        <!--  史莱姆桌宠：Skottie 循环播放 Lottie 动画；动画内容仅占视口 43% 宽，Zoom 2.2 让形象充满控件  -->
        <ui:LottieView
            Width="180"
            Height="180"
            VerticalAlignment="Bottom"
            Source="pack://application:,,,/Assets/shrime.json"
            Zoom="1.8" />
    </Grid>
</UserControl>

<UserControl
    x:Class="Context.App.PetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Orrest.Ui.Controls;assembly=Orrest.Ui"
    xmlns:vm="clr-namespace:Context.Presentation.ViewModels;assembly=Context.Presentation"
    d:DataContext="{d:DesignInstance Type=vm:PetViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <!--  ViewModel 初始化走 Behavior：Loaded 触发设置加载  -->
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <!--  透明画刷可命中测试：整个窗口范围都是悬浮区；右键弹出操作菜单  -->
    <Grid
        x:Name="PetRoot"
        Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem
                    Command="{Binding NextWallpaperCommand}"
                    Header="壁纸" />
                <MenuItem
                    Command="{Binding OpenDictionaryCommand}"
                    Header="词典" />
                <MenuItem
                    Command="{Binding ToggleTopmostCommand}"
                    Header="置顶"
                    IsCheckable="True"
                    IsChecked="{Binding IsTopmost, Mode=OneWay}" />
                <MenuItem
                    Command="{Binding ToggleThemeCommand}"
                    Header="暗色主题"
                    IsCheckable="True"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
                <Separator />
                <MenuItem
                    Click="OnExitClick"
                    Header="退出" />
            </ContextMenu>
        </Grid.ContextMenu>
        <!--  史莱姆桌宠：Skottie 循环播放 Lottie 动画；动画内容仅占视口 43% 宽，Zoom 1.8 让形象充满控件  -->
        <ui:LottieView
            Width="180"
            Height="180"
            VerticalAlignment="Bottom"
            Source="pack://application:,,,/Assets/shrime.json"
            Zoom="1.8" />
    </Grid>
</UserControl>

<UserControl
    x:Class="Context.App.PetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Context.Presentation.ViewModels;assembly=Context.Presentation"
    d:DataContext="{d:DesignInstance Type=vm:PetViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <!--  透明画刷可命中测试：整个窗口范围都是悬浮区  -->
    <Grid
        Background="Transparent"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave">
        <!--  悬浮按钮组：鼠标进入后浮出  -->
        <StackPanel
            x:Name="ActionButtonPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Panel.ZIndex="99"
            Visibility="Collapsed">
            <Button
                Command="{Binding NextWallpaperCommand}"
                Content="换壁纸" />
            <Button
                Click="OnExitClick"
                Content="退出" />
        </StackPanel>
        <!--  史莱姆占位：后续替换为桌宠形象  -->
        <Rectangle
            Width="160"
            Height="160"
            VerticalAlignment="Bottom"
            Fill="Black"
            Stroke="Gray"
            StrokeThickness="4" />
    </Grid>
</UserControl>

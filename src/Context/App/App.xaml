<Application
    x:Class="Context.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Orrest.Ui 对外只经 Themes/Generic.xaml 暴露：合并它即获得全部样式资源  -->
                <ResourceDictionary Source="pack://application:,,,/Orrest.Ui;component/Themes/Generic.xaml" />
                <!--  主题字典（Theme.Light|Dark.xaml）不在此合并：由 ThemeManager 在启动与运行时统一管理  -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

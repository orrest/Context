<Project Sdk="Microsoft.NET.Sdk">

  <!--  应用层视图与组合根位于 App/ 子目录：ApplicationDefinition 显式声明，
        并从默认 Page 通配中排除，避免构建动作冲突  -->
  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
    <Page Remove="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin\Plugin.csproj" />
    <ProjectReference Include="..\Plugins\Slime\Slime.csproj" />
    <ProjectReference Include="..\Plugins\Dictionary\Dictionary.csproj" />
    <ProjectReference Include="..\Plugins\Wallpaper\Wallpaper.csproj" />
    <ProjectReference Include="..\Plugins\Music\Music.csproj" />
    <ProjectReference Include="..\..\ui\src\Orrest.Ui\Orrest.Ui.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Console window in Debug for log output; hidden windowless WinExe in Release -->
    <!-- Debug 下保留控制台窗口便于查看日志输出，Release 下输出 WinExe 隐藏控制台 -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
